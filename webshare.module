<?php

/**
 * @file
 * Webshare — social sharing module.
 *
 * Rendering is delegated entirely to the `webshare:share` SDC component
 * and the `share` Block plugin. The module does not auto-inject the
 * share buttons into node display or entity forms: site builders place
 * the Share block via Block layout (theme regions) or insert the SDC
 * via Drupal Canvas templates.
 */

/**
 * Implements hook_theme().
 *
 * Registers the legacy `webshare-platform.html.twig` template so the
 * `vartheme_social` icon pack and similar caller integrations can use
 * the existing template hooks. The Share component itself ships with its
 * own SDC twig and does not rely on these hooks.
 */
function webshare_theme($existing, $type, $theme, $path) {
  $template_vars = [
    'url' => NULL,
    'content' => NULL,
    'platform' => NULL,
  ];

  $variables = [];

  try {
    $database = \Drupal::database();
    if ($database->schema()->tableExists('webshare_platforms')) {
      $platforms = $database->select('webshare_platforms', 'wp')
        ->fields('wp', ['platform_id'])
        ->execute()
        ->fetchCol();

      foreach ($platforms as $platform_id) {
        $variables['webshare_' . $platform_id] = [
          'variables' => $template_vars,
          'template' => 'webshare-platform',
        ];
      }
    }
  }
  catch (\Exception $e) {
    // Bootstrap before the platforms table exists — fall through to defaults.
  }

  foreach (['facebook_share', 'x', 'linkedin', 'whatsapp', 'copy'] as $platform_id) {
    if (!isset($variables['webshare_' . $platform_id])) {
      $variables['webshare_' . $platform_id] = [
        'variables' => $template_vars,
        'template' => 'webshare-platform',
      ];
    }
  }

  return $variables;
}
