<?php

/**
 * @file
 * Install, update and uninstall functions for the webshare module.
 */

use Drupal\Core\Database\Database;

/**
 * Implements hook_schema().
 */
function webshare_schema()
{
    $schema = [];

    $schema['webshare_platforms'] = [
    'description' => 'Table for storing social media platform configurations.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => true,
        'description' => 'Primary Key: Unique platform ID.',
      ],
      'platform_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => true,
        'description' => 'Machine name for the platform.',
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => true,
        'description' => 'Human readable name of the platform.',
      ],
      'title' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => true,
        'description' => 'Title shown on hover.',
      ],
      'enabled' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => true,
        'default' => 1,
        'description' => 'Whether the platform is enabled.',
      ],
      'image' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => true,
        'description' => 'Path to the platform icon.',
      ],
      'weight' => [
        'type' => 'int',
        'not null' => true,
        'default' => 0,
        'description' => 'Weight for ordering platforms.',
      ],
      'url_template' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => false,
        'description' => 'URL template for sharing.',
      ],
      'is_custom' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => true,
        'default' => 0,
        'description' => 'Whether this is a custom platform added by admin.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => true,
        'default' => 0,
        'description' => 'Timestamp when the platform was created.',
      ],
      'updated' => [
        'type' => 'int',
        'not null' => true,
        'default' => 0,
        'description' => 'Timestamp when the platform was last updated.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'platform_id' => ['platform_id'],
    ],
    'indexes' => [
      'enabled_weight' => ['enabled', 'weight'],
    ],
    ];

    return $schema;
}

/**
 * Implements hook_install().
 */
function webshare_install()
{
  // Migrate existing configuration to database.
    _webshare_migrate_default_platforms();
}

/**
 * Helper function to migrate default platforms to database.
 */
function _webshare_migrate_default_platforms()
{
    $config = \Drupal::config('webshare.settings');
    $buttons = $config->get('buttons');

  if (empty($buttons)) {
      return;
  }

    $database = Database::getConnection();
    $default_templates = [
    'facebook_share' => 'https://www.facebook.com/sharer/sharer.php?u=[url]',
    'x'              => 'https://twitter.com/intent/tweet?url=[url]&text=[title]',
    'linkedin'       => 'https://www.linkedin.com/sharing/share-offsite/?url=[url]',
    'whatsapp'       => 'https://api.whatsapp.com/send?text=[title]%20[url]',
    'copy'           => '',
    'email'          => 'mailto:?subject=[title]&body=[url]',
    'telegram'       => 'https://t.me/share/url?url=[url]&text=[title]',
    'reddit'         => 'https://www.reddit.com/submit?url=[url]&title=[title]',
    'pinterest'      => 'https://www.pinterest.com/pin/create/button/?url=[url]&description=[title]',
    'threads'        => 'https://www.threads.net/intent/post?text=[title]%20[url]',
    'bluesky'        => 'https://bsky.app/intent/compose?text=[title]%20[url]',
    'tumblr'         => 'https://www.tumblr.com/share/link?url=[url]&name=[title]',
    'mastodon'       => 'https://mastodonshare.com/?url=[url]&text=[title]',
    ];

    foreach ($buttons as $platform_id => $button) {
      if ($platform_id === 'facebook_like') {
          continue;
      }

        $database->insert('webshare_platforms')
        ->fields([
        'platform_id' => $platform_id,
        'name' => $button['name'],
        'title' => $button['title'] ?? $button['name'],
        'enabled' => $button['enabled'] ?? 1,
        'image' => $button['image'],
        'weight' => $button['weight'] ?? 0,
        'url_template' => $default_templates[$platform_id] ?? '',
        'is_custom' => 0,
        'created' => \Drupal::time()->getRequestTime(),
        'updated' => \Drupal::time()->getRequestTime(),
        ])
        ->execute();
    }
}

/**
 * Create webshare_platforms table and migrate existing data.
 */
function webshare_update_8001()
{
    $schema = webshare_schema();
    $schema_handler = \Drupal::database()->schema();

  if (!$schema_handler->tableExists('webshare_platforms')) {
      $schema_handler->createTable('webshare_platforms', $schema['webshare_platforms']);
      _webshare_migrate_default_platforms();
  }
}

/**
 * Reorder default platforms to match the approved design (LinkedIn, Facebook, X).
 */
function webshare_update_8002()
{
    $database = Database::getConnection();

  if (!$database->schema()->tableExists('webshare_platforms')) {
      return;
  }

  // New default weights for the non-custom platforms. Custom platforms keep
  // their existing weight so admins do not lose a manual ordering.
    $default_weights = [
    'linkedin' => 0,
    'facebook_share' => 1,
    'x' => 2,
    'whatsapp' => 3,
    'copy' => 4,
    ];

    foreach ($default_weights as $platform_id => $weight) {
      $database->update('webshare_platforms')
        ->fields(['weight' => $weight])
        ->condition('platform_id', $platform_id)
        ->condition('is_custom', 0)
        ->execute();
    }
}

/**
 * Replace `left` / `right` alignment with logical `start` / `end` values.
 */
function webshare_update_8003()
{
    $config = \Drupal::configFactory()->getEditable('webshare.settings');
    $current = $config->get('alignment');
    $map = ['left' => 'start', 'right' => 'end'];
  if (isset($map[$current])) {
      $config->set('alignment', $map[$current])->save();
      return t('Migrated webshare alignment from @from to @to.', [
        '@from' => $current,
        '@to' => $map[$current],
      ]);
  }
    return t('Webshare alignment already uses logical values.');
}

/**
 * Initialise empty icon_map + native_share_icon keys (Icons API integration).
 *
 * The module is icon-library agnostic, so no defaults are seeded here.
 * Site builders pick a pack (bootstrap_icons, phosphor, font-awesome,
 * material_symbols, etc.) by overriding webshare.settings.icon_map and
 * webshare.settings.native_share_icon. Vartheme BS5 ships a Varbase
 * preset that wires the bootstrap_icons pack on Varbase sites.
 */
function webshare_update_8004() {
    $config = \Drupal::configFactory()->getEditable('webshare.settings');
    $changed = FALSE;
  if ($config->get('icon_map') === NULL) {
      $config->set('icon_map', []);
      $changed = TRUE;
  }
  if ($config->get('native_share_icon') === NULL) {
      $config->set('native_share_icon', []);
      $changed = TRUE;
  }
  if ($changed) {
      $config->save();
      return t('Webshare Icons API config keys initialised.');
  }
    return t('Webshare Icons API config keys already present.');
}

